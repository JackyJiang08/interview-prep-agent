# Copy to .env and adjust as needed. .env is gitignored and loaded during
# settings resolution; values already exported in the shell win over it.
#
# The default paths need no credentials. Extraction and matching run locally
# with their lexical defaults, which is what the committed example, the tests
# and CI all use. Only the llm stages and the prep command call a provider.

# Path to a settings file. Overrides configs/default.yaml.
IPA_CONFIG=configs/default.yaml

# Model provider credentials. The default provider is gemini; --provider
# azure selects the other. Required for --extractor llm, --matcher llm, and
# the prep, agent and eval --suite live commands.
GEMINI_API_KEY=

# Optional. Overrides the default model for every model-backed stage.
GEMINI_MODEL=gemini-3.5-flash-lite

# The second provider. Endpoint, key and deployment are all required when
# --provider azure is selected; the api version is defaulted.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional. Enables the role-research search path; absent means the search
# path is simply inactive, never an error.
TAVILY_API_KEY=

# Optional observability, off by default. When LANGSMITH_TRACING=true and a
# key is set, provider calls and graph runs are traced. Traced runs upload
# inputs and outputs to the tracing service — use synthetic data, never a
# real posting or a real resume.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
