# Copy to .env and adjust as needed. .env is gitignored.
#
# The pipeline needs no credentials today: the baseline matcher is local and
# deterministic, and nothing calls a network service. This file exists so that
# configuration has one documented home from the start.

# Path to a settings file. Overrides configs/default.yaml.
# Leave unset to use the packaged defaults.
JDEM_CONFIG=configs/default.yaml
