# Copy to .env and adjust as needed. .env is gitignored.
#
# The default path needs no credentials. Extraction runs locally with
# --extractor lexical, which is what the committed example, the tests and CI
# all use. Only --extractor llm calls out to a provider.

# Path to a settings file. Overrides configs/default.yaml.
# Leave unset to use the packaged defaults.
IPA_CONFIG=configs/default.yaml

# Required only for --extractor llm. Without it that mode fails immediately
# with a message telling you to set this or fall back to lexical.
GEMINI_API_KEY=

# Optional. Overrides the default model used for model-backed extraction.
GEMINI_MODEL=gemini-3.5-flash-lite
